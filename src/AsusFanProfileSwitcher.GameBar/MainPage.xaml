<Page
    x:Class="AsusFanProfileSwitcher.GameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                FontFamily="Segoe UI Semibold"
                FontSize="28"
                Foreground="White"
                Text="ASUS Fan Profile Switcher" />
            <TextBlock
                Margin="0,16,0,0"
                FontSize="16"
                Foreground="{StaticResource MutedBrush}"
                Text="This companion app provides the Xbox Game Bar widget."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,12,0,0"
                Foreground="White"
                Text="Start the desktop controller as administrator, press Win+G, open the Widget Menu, and select “ASUS Fan Profiles”."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
